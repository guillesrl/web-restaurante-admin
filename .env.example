# Base de datos Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# API
VITE_API_URL=/api

# Server
PORT=80
NODE_ENV=production

# Autenticación (contraseña única). Si DASHBOARD_PASSWORD está vacía, la auth queda deshabilitada.
DASHBOARD_PASSWORD=
JWT_SECRET=

# Notificaciones Telegram (opcional). Si faltan, no se envían notificaciones.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API privada para el agente de pedidos
AGENT_ORDER_API_KEY=

# Webhook n8n para avisos de pedido entregado
N8N_DELIVERY_WEBHOOK_URL=https://n8n.guillers.es/webhook/restaurant-order-delivered
N8N_DELIVERY_WEBHOOK_TOKEN=
