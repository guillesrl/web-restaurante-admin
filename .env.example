# Base de datos PostgreSQL local de desarrollo
DATABASE_URL=postgresql://user:password@localhost:5432/dashboard_restaurante
# Usa true si el servidor PostgreSQL requiere TLS.
DATABASE_SSL=false

# API
VITE_API_URL=/api

# Servidor: Vite usa el puerto 3002 y envía /api a Express en el 8080.
PORT=8080
NODE_ENV=development

# Sin usuarios creados ni contraseña compartida, el acceso local queda abierto.
DASHBOARD_PASSWORD=
DASHBOARD_AUTH_SECRET=

# Notificaciones Telegram (opcional). Si faltan, no se envían notificaciones.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API privada para el agente de pedidos
AGENT_ORDER_API_KEY=

# Webhook n8n para avisos de pedido entregado
N8N_DELIVERY_WEBHOOK_URL=https://n8n.example.com/webhook/your-workflow-path
N8N_DELIVERY_WEBHOOK_TOKEN=

# Copias externas cifradas (opcionales)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
BACKUP_BUCKET=
BACKUP_ENCRYPTION_KEY=
BACKUP_INTERVAL_HOURS=24
