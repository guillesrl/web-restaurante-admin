      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH claimable AS (\n  SELECT id\n  FROM orders\n  WHERE status = 'out_for_delivery'\n    AND fulfillment_type = 'delivery'\n    AND COALESCE(telefono, '') <> ''\n    AND out_for_delivery_notification_due_at <= NOW()\n    AND out_for_delivery_notification_sent_at IS NULL\n    AND (out_for_delivery_notification_claimed_at IS NULL OR out_for_delivery_notification_claimed_at < NOW() - INTERVAL '10 minutes')\n  ORDER BY out_for_delivery_notification_due_at ASC\n  LIMIT 20\n  FOR UPDATE SKIP LOCKED\n)\nUPDATE orders AS o\nSET out_for_delivery_notification_claimed_at = NOW()\nFROM claimable\nWHERE o.id = claimable.id\nRETURNING o.id, o.nombre, o.telefono, o.direccion, o.total",
          "options": {}
        },
